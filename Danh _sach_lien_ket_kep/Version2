#include<stdio.h>
#include<stdlib.h>
#include<string.h>
typedef struct    {
    	char hoten[30];
    	int masv;
    	float d1, d2, d3;
}Data;
typedef struct tagNode    {
    	Data infor;
    	struct tagNode *next, *prev;
}Node;
typedef struct    {
    	Node *pHead;  
    	Node *pTail;
    	int spt;
}LList;
/////////////////////////////////////
void initList(LList *L)
    {
    	L->pHead = NULL;
    	L->pTail = NULL;
    	L->spt = 0;
    }
/////////////////////////////////////
int emptyList(LList L)
 {
    	return (L.spt == 0); 
}
int fullList(LList L)
 {
    	return (L.spt == 50); 
}
/////////////////////////////////////
void insert_Head(LList *L, Data x)
    {
    	Node *pp;
    	pp = (Node*) malloc(sizeof(Node));
    	pp->infor = x;
    	pp->next = NULL;
    	pp->prev = NULL;
    	if(emptyList(*L)){
    			L->pHead = pp;
    			L->pTail = pp;
    		}  	
        else {
    		L->pHead->prev = pp;
    		pp->next = L->pHead;
    		L->pHead = pp;
    		}
    	L->spt++;
    }
void insert_Tail(LList *L, Data x)
{
		Node *pp;
    	pp = (Node*) malloc(sizeof(Node));
    	pp->infor = x;
    	pp->next = NULL;
    	pp->prev = NULL;
    	if(emptyList(*L)){
    			L->pHead = pp;
    			L->pTail = pp;
    		}  	
        else {
    		L->pTail->next = pp;
    		pp->prev = L->pTail;
    		L->pTail = pp;
    		}
    	L->spt++;
}
void insert_After(LList *L, Node *q, Data x){
    Node *pp;
    if(NULL == q) return;
    else{
        pp = (Node*)malloc(sizeof(Node));
        pp->infor = x;
        pp->next = q->next;
        pp->prev = q;

        if(q->next != NULL)
            q->next->prev = pp;

        q->next = pp;

        if(q == L->pTail) L->pTail = pp;
        L->spt++;
    }
}

void del_Head(LList *L) {
    Node *pp;

    if (emptyList(*L)) {
        printf("Danh sach trong!\n");
        return;
    }

    pp = L->pHead;
    L->pHead = pp->next;

    if (L->pHead != NULL)
        L->pHead->prev = NULL;
    else
        L->pTail = NULL;

    free(pp);
    L->spt--;

    printf("Da xoa sinh vien o dau danh sach\n");
}

void del_After(LList *L, Node *q){
    Node *pp;
    if(NULL == q || q->next == NULL) return;
    else {
        pp = q->next;
        q->next = pp->next;

        if(pp->next != NULL)
            pp->next->prev = q;

        if(pp == L->pTail)
            L->pTail = q;

        free(pp);
        L->spt--;
    }
}

void del_K(LList *L, char K[30]){
    Node *pp = L->pHead, *q = NULL;

    while(pp != NULL && !strstr(pp->infor.hoten, K)){
        q = pp;
        pp = pp->next;
    }

    if(NULL == pp)
        printf("Khong tim thay sinh vien!\n");
    else if(pp == L->pHead)
        del_Head(L);
    else
        del_After(L, q);
}
